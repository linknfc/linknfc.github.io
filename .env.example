# VITE_PUBLIC_BASE_URL: URL base pública do seu GitHub Pages (com barra no final)
# Formato: https://USUARIO.github.io/REPOSITORIO/
# Exemplo: https://usuario.github.io/linknfc/
VITE_PUBLIC_BASE_URL="https://usuario.github.io/linknfc/"

# VITE_BASE_PATH: Caminho base para assets no Vite (opcional, padrão './' funciona para qualquer repo)
# Exemplo: /linknfc/
VITE_BASE_PATH="./"
